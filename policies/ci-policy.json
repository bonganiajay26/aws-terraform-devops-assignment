{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuthTokenRequiresWildcard",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPushToOneRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": "arn:aws:ecr:us-east-1:000000000000:repository/aws-terraform-devops-assignment-app"
    },
    {
      "Sid": "EcsRegisterTaskDefinitionRequiresWildcard",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "EcsDeployOneService",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:DescribeServices"
      ],
      "Resource": "arn:aws:ecs:us-east-1:000000000000:service/aws-terraform-devops-assignment-cluster/aws-terraform-devops-assignment-service"
    },
    {
      "Sid": "PassOnlyEcsTaskRolesToEcsTasks",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::000000000000:role/aws-terraform-devops-assignment-ecs-execution",
        "arn:aws:iam::000000000000:role/aws-terraform-devops-assignment-ecs-task"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ListArtifactBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::aws-terraform-devops-assignment-artifacts-000000000000"
    },
    {
      "Sid": "ReadArtifactObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::aws-terraform-devops-assignment-artifacts-000000000000/*"
    }
  ]
}
