# Copy to backend.hcl (git-ignored) and use the values from:
#   terraform -chdir=bootstrap output backend_hcl
#
#   Copy-Item backend.hcl.example backend.hcl
#   terraform init -backend-config=backend.hcl

bucket         = "aws-terraform-devops-assignment-tfstate-000000000000"
region         = "us-east-1"
dynamodb_table = "aws-terraform-devops-assignment-tf-locks"

# AWS CLI profile with access to the state bucket (Account A).
profile = "account-a"
