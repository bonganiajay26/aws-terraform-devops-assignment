# Copy to terraform.tfvars (git-ignored) and replace with real values.
#   Copy-Item terraform.tfvars.example terraform.tfvars

aws_region   = "us-east-1"
account_a_id = "000000000000"
project_name = "aws-terraform-devops-assignment"
environment  = "dev"
owner        = "platform-team"

# ----------------------------- Task 1 - EC2 -----------------------------
# Placeholder AMI (valid format, does not exist). Replace with a real x86_64
# AMI from YOUR region, e.g. latest Amazon Linux 2023:
#   aws ssm get-parameter --name /aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64 --query Parameter.Value --output text
ami_id = "ami-0123456789abcdef0"

# subnet_id              = "subnet-0123456789abcdef0"   # default: default VPC subnet
# vpc_security_group_ids = ["sg-0123456789abcdef0"]     # default: VPC default SG

# ONE variable -> five differently configured instances (for_each).
# Key pairs must already exist in the region (see tests/task1-test.md).
instances = {
  web01 = {
    instance_type    = "t3.micro"
    root_volume_type = "gp3"
    root_volume_size = 20
    key_name         = "web01-key"
  }

  web02 = {
    instance_type    = "t3.small"
    root_volume_type = "gp2"
    root_volume_size = 30
    key_name         = "web02-key"
  }

  # Critical production instance: io2 + prevent_destroy + termination protection.
  # io2 limit check: 3000 IOPS <= 1000 IOPS/GiB * 50 GiB = 50000. Valid.
  web03 = {
    instance_type    = "t3.medium"
    root_volume_type = "io2"
    root_volume_size = 50
    root_volume_iops = 3000
    key_name         = "web03-key"
    environment      = "prod"
    protected        = true
  }

  # gp3 with provisioned performance: 6000 IOPS <= 500 * 80 = 40000; 250 MiB/s <= 6000/4 = 1500. Valid.
  web04 = {
    instance_type          = "t3.large"
    root_volume_type       = "gp3"
    root_volume_size       = 80
    root_volume_iops       = 6000
    root_volume_throughput = 250
    key_name               = "web04-key"
  }

  # io1: 4000 IOPS <= 50 IOPS/GiB * 100 GiB = 5000. Valid.
  web05 = {
    instance_type    = "t3.xlarge"
    root_volume_type = "io1"
    root_volume_size = 100
    root_volume_iops = 4000
    key_name         = "web05-key"
  }
}

# ----------------------------- Task 3 - IAM -----------------------------
# Account B hosts roleC; roleB may assume ONLY arn:aws:iam::<account_b_id>:role/roleC.
account_b_id = "111111111111"

# group2 (console + CLI). engine and ci (group1) are fixed and programmatic-only.
console_user_names = ["developer1", "developer2"]

# Console login profiles are created by Terraform ONLY when a PGP key is set
# (state/outputs then hold only the encrypted password). Leave unset to keep all
# passwords out of Terraform and provision them out of band (tests/task3-test.md).
# console_pgp_key = "keybase:your-keybase-user"

# ------------------------- Task 4 - CI policy targets -------------------------
# The ONE repository / service / role pair / bucket the ci user may use.
# These resources are NOT created by this repository; exact ARNs are built from
# these names + account_a_id + aws_region (see ci-policy.tf). No wildcards allowed.
ci_ecr_repository_name          = "aws-terraform-devops-assignment-app"
ci_ecs_cluster_name             = "aws-terraform-devops-assignment-cluster"
ci_ecs_service_name             = "aws-terraform-devops-assignment-service"
ci_ecs_task_execution_role_name = "aws-terraform-devops-assignment-ecs-execution"
ci_ecs_task_role_name           = "aws-terraform-devops-assignment-ecs-task"
# ci_artifact_bucket_name       = "my-build-artifacts"   # default: <project>-artifacts-<account_a_id>
