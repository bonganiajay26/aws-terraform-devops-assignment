<#
    Shared helpers for the local POC scripts.

    New-OfflineWorkspace copies ONE root module (flat *.tf / *.example / lock file)
    plus modules/ into a TEMP folder, drops backend.tf and adds a mock-credential
    provider override, then runs `terraform init` using the providers ALREADY
    downloaded in the repo (-plugin-dir, no network download).

    Result: `terraform plan` runs with zero AWS API calls, and nothing - no override
    file, no .terraform metadata, no state - is ever written inside the repository.
#>

$script:OfflineProviderOverride = @'
# GENERATED by scripts/OfflineWorkspace.psm1 - OFFLINE PLAN ONLY (TEMP copy).
# Mock credentials, every AWS API call skipped. Never use for apply.
provider "aws" {
  access_key                  = "mock-access-key"
  secret_key                  = "mock-secret-key"
  allowed_account_ids         = []
  skip_credentials_validation = true
  skip_requesting_account_id  = true
  skip_metadata_api_check     = true
  skip_region_validation      = true
}
'@

function Invoke-Terraform {
    # Runs terraform, returns @{ Exit = <int>; Text = <combined stdout+stderr> }.
    param([string[]]$Arguments)
    $text = (& terraform @Arguments *>&1 | Out-String)
    return @{ Exit = $LASTEXITCODE; Text = $text }
}

function New-OfflineWorkspace {
    <#
    .PARAMETER KeepBackend
        Keep backend.tf and do NOT add the mock provider override (used to test
        real backend initialisation behaviour).
    #>
    param(
        [Parameter(Mandatory = $true)][string]$RepoRoot,
        [Parameter(Mandatory = $true)][string]$Stack,
        [Parameter(Mandatory = $true)][string]$Destination,
        [switch]$KeepBackend
    )

    $source = Join-Path $RepoRoot $Stack
    $target = Join-Path $Destination $Stack
    New-Item -ItemType Directory -Force -Path $target | Out-Null

    $excluded = '^(terraform\.tfvars(\.json)?|backend\.hcl|.*override\.tf(\.json)?|.*\.tfstate.*|.*\.tfplan)$'
    Get-ChildItem -File -Force -Path $source |
        Where-Object { $_.Name -notmatch $excluded } |
        Where-Object { $KeepBackend -or $_.Name -ne 'backend.tf' } |
        ForEach-Object { Copy-Item $_.FullName (Join-Path $target $_.Name) }

    $modules = Join-Path $RepoRoot 'modules'
    if (Test-Path $modules) {
        Copy-Item -Recurse -Force $modules (Join-Path $Destination 'modules')
    }

    if (-not $KeepBackend) {
        [System.IO.File]::WriteAllText((Join-Path $target 'offline_override.tf'), $script:OfflineProviderOverride)
    }
    return $target
}

function Get-RepoPluginDir {
    # Providers downloaded by `terraform init` in the repo (validate-local.ps1 runs it first).
    param(
        [Parameter(Mandatory = $true)][string]$RepoRoot,
        [Parameter(Mandatory = $true)][string]$Stack
    )
    return (Join-Path $RepoRoot "$Stack\.terraform\providers")
}

function Remove-TempWorkspace {
    # Windows can keep the provider .exe locked for a moment after terraform exits;
    # retry instead of silently leaving hundreds of MB behind in %TEMP%.
    param([Parameter(Mandatory = $true)][string]$Path)
    for ($attempt = 1; $attempt -le 10; $attempt++) {
        if (-not (Test-Path $Path)) { return }
        Remove-Item -Recurse -Force $Path -ErrorAction SilentlyContinue
        if (-not (Test-Path $Path)) { return }
        Start-Sleep -Seconds 1
    }
    Write-Warning "Could not fully remove $Path (file still locked). Delete it manually."
}

Export-ModuleMember -Function Invoke-Terraform, New-OfflineWorkspace, Get-RepoPluginDir, Remove-TempWorkspace
